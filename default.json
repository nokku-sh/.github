{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared renovate preset for nokku-sh repos, use with local>nokku-sh/.github",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":disableDependencyDashboard",
    ":maintainLockFilesWeekly",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "timezone": "Europe/Vienna",
  "minimumReleaseAge": "7 days",
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "platformAutomerge": true,
  "separateMinorPatch": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "semanticCommitType": "sec"
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Everything below a major merges on its own, CI is the gate",
      "matchUpdateTypes": ["minor", "patch", "digest", "pinDigest", "bump"],
      "groupName": "non-major dependencies",
      "automerge": true
    },
    {
      "description": "Majors wait for a review",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Apps build with the newest Go, the go line in the root go.mod is their toolchain",
      "matchDepTypes": ["golang"],
      "matchFileNames": ["go.mod"],
      "rangeStrategy": "bump",
      "semanticCommitType": "fix"
    },
    {
      "description": "The toolchain line picks the Go a binary is built with, so a bump has to release",
      "matchDepTypes": ["toolchain"],
      "semanticCommitType": "fix"
    },
    {
      "description": "Go releases get a PR of their own, so a Go minor that breaks the linter blocks nothing else",
      "matchDatasources": ["golang-version"],
      "groupName": null
    },
    {
      "description": "Go patch releases are security releases from the Go team, ship them right away",
      "matchDatasources": ["golang-version"],
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": null,
      "semanticCommitType": "sec"
    },
    {
      "description": "Frontend deps are bundled into the binary, so their updates should release",
      "matchFileNames": ["web/**", "core/web/**"],
      "semanticCommitType": "fix"
    },
    {
      "description": "Shared workflows track main on purpose",
      "matchDepNames": ["nokku-sh/.github"],
      "enabled": false
    }
  ]
}
